+static uint64_t monotonic_us(void)
+{
+   struct timespec now;
+   if (clock_gettime(CLOCK_MONOTONIC, &now) || now.tv_sec < 0 || now.tv_nsec < 0 || now.tv_nsec >= 1000000000L ||
+       (uint64_t)now.tv_sec > (UINT64_MAX - 999999ull) / 1000000ull)
+      control_failure(74, "monotonic clock unavailable or outside representable range");
+   return (uint64_t)now.tv_sec * 1000000ull + (uint64_t)now.tv_nsec / 1000ull;
+}
+
+static void wait_gfx_boot(void)
+{
+   const uint64_t start = monotonic_us();
+   uint64_t last = start;
+   for (unsigned sample = 0; sample < PHX_GFX_BOOT_MAX_POLLS; ++sample) {
+      uint64_t before = monotonic_us();
+      if (before < last || before - start >= PHX_GFX_BOOT_TIMEOUT_US)
+         control_failure(75, "GFX boot deadline expired or clock moved backwards");
+      uint32_t cp = 0, rlc = 0;
+      read_reg(PHX_GFX_BOOT_CP_STAT, &cp);
+      read_reg(PHX_GFX_BOOT_RLC_STATUS, &rlc);
+      uint64_t after = monotonic_us();
+      if (after < before || after - start >= PHX_GFX_BOOT_TIMEOUT_US)
+         control_failure(75, "GFX boot observation arrived after the deadline or clock moved backwards");
+      if (cp == 0 && rlc != UINT32_MAX && (rlc & PHX_GFX_BOOT_COMPLETE)) return;
+      last = after;
+      const struct timespec delay = {0, 1000000L};
+      if (nanosleep(&delay, NULL) && errno != EINTR)
+         control_failure(74, "GFX boot polling delay failed");
+   }
+   control_failure(75, "GFX boot sample limit exhausted without readiness");
 }
 
