+    PhxPspLayout layout;
+    memcpy(&layout, a->structureInput, sizeof(layout));
+    uint64_t out[4]{};
+    IOReturn r = owner->configurePspLayout(layout, out);
+    if (r == kIOReturnSuccess)
+        for (unsigned i = 0; i < 4; ++i) a->scalarOutput[i] = out[i];
+    return r;
+}
