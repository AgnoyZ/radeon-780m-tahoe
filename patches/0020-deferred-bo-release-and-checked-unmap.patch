+    if (c->lastSeq && gpuRetired() < c->lastSeq) return kIOReturnBusy;
+    if (c->hw && !vmBindingValid(c->hw, c->phys)) {
+        hwv[c->hw - kFirstUserVmid].faulted = true;
+        return kIOReturnNotReady;
+    }
+    return kIOReturnSuccess;
+}
